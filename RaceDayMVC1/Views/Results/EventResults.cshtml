@model List<RaceDayMVC1.Models.ResultViewModel>

@{
    ViewData["Title"] = "Event Results";
}

<div class="container mt-4">

    <h2 class="fw-bold">Event Results</h2>

    <p class="text-muted">
        View and manage participant race results.
    </p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center p-5">
                <h5>No Results Yet</h5>
                <p class="text-muted">
                    No race results have been recorded for this event.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Participant</th>
                                <th>Finish Time</th>
                                <th>Position</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var result in Model)
                            {
                                <tr>
                                    <td>@result.ParticipantName</td>
                                    <td>@result.FinishTime</td>
                                    <td>@result.Position</td>
                                    <td>@result.ResultStatus</td>
                                    <td>
                                        <a asp-action="Edit"
                                           asp-route-id="@result.Id"
                                           asp-route-eventId="@ViewBag.EventId"
                                           class="btn btn-sm btn-primary">
                                            Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>

            </div>
        </div>
    }

</div>
