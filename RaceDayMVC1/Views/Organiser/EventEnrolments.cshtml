@model List<RaceDayMVC1.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "Event Enrolments";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Event Enrolments</h2>

            <p class="text-muted">
                View participants registered for your event.
            </p>

            <h5>@ViewBag.EventName</h5>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center p-5">
                <h5>No Participants Yet</h5>

                <p class="text-muted">
                    No participants have registered for this event yet.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <h5 class="mb-3">Registered Participants</h5>

                <div class="table-responsive">

                    <table class="table table-bordered table-striped align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Participant</th>
                                <th>Category</th>
                                <th>Enrolment Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var enrolment in Model)
                            {
                                <tr>

                                    <td>@enrolment.ParticipantName</td>

                                    <td>@enrolment.CategoryName</td>

                                    <td>
                                        @enrolment.EnrolmentDate.ToString("dd MMMM yyyy HH:mm")
                                    </td>

                                    <td>@enrolment.Status</td>

                                    <td>
                                        @if (enrolment.Status == "Registered")
                                        {
                                            <a asp-controller="Results"
                                               asp-action="Create"
                                               asp-route-enrolmentId="@enrolment.Id"
                                               asp-route-eventId="@ViewBag.EventId"
                                               class="btn btn-success btn-sm">
                                                Record Result
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not available
                                            </span>
                                        }
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <p class="text-muted mb-0">
                    Total registered participants: @Model.Count
                </p>

            </div>
        </div>
    }

</div>
