@model List<RaceDayMVC1.Models.EventCategoriesViewModel>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Manage Categories</h2>
            <p class="text-muted">
                Manage participant categories for your sporting events.
            </p>
        </div>

        <a asp-controller="Organiser"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center p-5">
                <h5>No Events Found</h5>
                <p class="text-muted">
                    Create an event before adding categories.
                </p>

                <a asp-action="CreateEvent"
                   class="btn btn-primary">
                    Create Event
                </a>
            </div>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="card shadow-sm mb-4">

                <div class="card-header text-white"
                     style="background-color: #172554;">

                    <h5 class="mb-0">
                        @item.Event.Name
                    </h5>

                </div>

                <div class="card-body">

                    <p class="text-muted">
                        @item.Event.Description
                    </p>

                    <p>
                        <strong>Date:</strong>
                        @item.Event.EventDate.ToString("dd MMMM yyyy")
                    </p>

                    <p>
                        <strong>Location:</strong>
                        @item.Event.Location
                    </p>

                    <p>
                        <strong>Distance:</strong>
                        @item.Event.DistanceKm km
                    </p>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h5>Participant Categories</h5>

                        <a asp-action="CreateCategory"
                           asp-route-eventId="@item.Event.Id"
                           class="btn btn-primary btn-sm">
                            Add Category
                        </a>

                    </div>

                    @if (item.Categories == null || !item.Categories.Any())
                    {
                        <div class="alert alert-info">
                            No categories have been created for this event yet.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-bordered table-striped align-middle">

                                <thead class="table-light">
                                    <tr>
                                        <th>Category</th>
                                        <th>Description</th>
                                        <th>Entry Fee</th>
                                        <th>Maximum Participants</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var category in item.Categories)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@category.Name</strong>
                                            </td>

                                            <td>
                                                @category.Description
                                            </td>

                                            <td>
                                                @category.EntryFee.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))
                                            </td>

                                            <td>
                                                @category.MaxParticipants
                                            </td>

                                            <td>
                                                <div class="d-flex gap-2">

                                                    <a asp-action="EditCategory"
                                                       asp-route-id="@category.Id"
                                                       class="btn btn-warning btn-sm">
                                                        Edit
                                                    </a>

                                                    <form asp-action="DeleteCategory"
                                                          method="post"
                                                          onsubmit="return confirm('Are you sure you want to delete this category?');">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@category.Id" />

                                                        <button type="submit"
                                                                class="btn btn-danger btn-sm">
                                                            Delete
                                                        </button>

                                                    </form>

                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>

                        </div>
                    }

                </div>
            </div>
        }
    }

</div>
