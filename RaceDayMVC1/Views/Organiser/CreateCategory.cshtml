@model RaceDayMVC1.Models.CategoryViewModel

@{
    ViewData["Title"] = "Create Category";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header text-white"
             style="background-color: #172554;">

            <h3 class="mb-0">Create Event Category</h3>

        </div>

        <div class="card-body">

            <h5 class="mb-3">
                Event: @ViewBag.EventName
            </h5>

            <form asp-action="CreateCategory"
                  asp-controller="Organiser"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="EventId" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                        Category Name
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Example: 10 KM Run" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"
                              placeholder="Describe this race category">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="EntryFee"
                           class="form-label">
                        Entry Fee (R)
                    </label>

                    <input asp-for="EntryFee"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control"
                           placeholder="Enter entry fee" />

                    <span asp-validation-for="EntryFee"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="MaxParticipants"
                           class="form-label">
                        Maximum Participants
                    </label>

                    <input asp-for="MaxParticipants"
                           type="number"
                           min="1"
                           class="form-control"
                           placeholder="Example: 500" />

                    <span asp-validation-for="MaxParticipants"
                          class="text-danger">
                    </span>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Create Category
                    </button>

                    <a asp-action="ManageCategories"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

